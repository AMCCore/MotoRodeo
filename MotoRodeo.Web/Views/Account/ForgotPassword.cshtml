@model ForgotPasswordForm
@{
    ViewData["Title"] = "Восстановление пароля";
}
<h1 class="h4 mb-3">Восстановление пароля</h1>
@if (!string.IsNullOrEmpty(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
    <a class="btn btn-primary w-100 py-3" asp-action="Login">Перейти ко входу</a>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    <form method="post" asp-action="ForgotPassword">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" type="email" />
        </div>
        <button type="submit" class="btn btn-primary w-100 py-3 mb-2">Восстановить</button>
        <a class="btn btn-outline-secondary w-100 py-3" asp-action="Login">Вход</a>
    </form>
}
