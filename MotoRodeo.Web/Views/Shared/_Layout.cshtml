@using DMCorp.Framework.Basics.Security
@using MotoRodeo.DAL.Enums
@inject IAdvancedSecurityService Security
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? "МотоРодео")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Events" asp-action="Index">МотоРодео</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu" aria-label="Меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="menu">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">Меню</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
                </div>
                <div class="offcanvas-body">
                    @if (Security.IsAuthenticated)
                    {
                        <p class="text-white-50">@User.Identity?.Name</p>
                        <a class="btn btn-outline-light w-100 mb-2 py-3" asp-controller="Events" asp-action="Index">События</a>
                        @if (Security.HasRight(AccountRightEnum.ManageEvents))
                        {
                            <a class="btn btn-outline-light w-100 mb-2 py-3" asp-controller="Events" asp-action="Create">Новое событие</a>
                        }
                        @if (Security.IsAdmin)
                        {
                            <a class="btn btn-outline-light w-100 mb-2 py-3" asp-controller="Accounts" asp-action="Index">Пользователи</a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100 py-3">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light w-100 mb-2 py-3" asp-controller="Account" asp-action="Login">Вход</a>
                        <a class="btn btn-primary w-100 py-3" asp-controller="Account" asp-action="Register">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main class="container py-3">
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        @RenderBody()
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>