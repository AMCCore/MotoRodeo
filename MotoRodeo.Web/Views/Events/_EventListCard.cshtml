@model EventListItemDto
<div class="card mb-2">
    <div class="card-body">
        <h3 class="h6 card-title mb-1">
            <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.Title (@AppTimeZone.ToLocal(Model.EventDate).ToString("dd.MM"))</a>
        </h3>
        <p class="card-text mb-1 text-muted small">
            @AppTimeZone.ToLocal(Model.EventDate).ToString("dd.MM.yyyy HH:mm") · @Model.Place
        </p>
        <p class="card-text @(Model.CanViewParticipantCounts ? "mb-1" : "mb-0") text-muted small">
            Регистрация до @AppTimeZone.ToLocal(Model.RegistrationClosesAt).ToString("dd.MM.yyyy HH:mm")
        </p>
        <p class="card-text mb-0 text-muted small">
            Участников: @Model.ConfirmedParticipantCount
            @if (Model.CanViewParticipantCounts && Model.PendingApplicationCount > 0)
            {
                <text> · Заявок: @Model.PendingApplicationCount</text>
            }
        </p>
    </div>
</div>