@model EventDetailsDto
@{
    ViewData["Title"] = Model.Title;
    string StatusLabel(ParticipantStatusEnum s) => s switch
    {
        ParticipantStatusEnum.Draft => "Заявлен",
        ParticipantStatusEnum.Confirmed => "Согласован",
        ParticipantStatusEnum.Rejected => "Отклонён",
        _ => s.ToString()
    };
    var participantGroups = new (string Title, IReadOnlyList<EventParticipantDto> Items)[]
    {
        ("Заявленные", Model.Participants.Where(p => p.Status == ParticipantStatusEnum.Draft).ToList()),
        ("Согласованные", Model.Participants.Where(p => p.Status == ParticipantStatusEnum.Confirmed).ToList()),
        ("Отклонённые", Model.Participants.Where(p => p.Status == ParticipantStatusEnum.Rejected).ToList())
    };
    var cancelConfirmMessage = $"Вы уверены что хотите отменить мероприятие {Model.Title} ({AppTimeZone.ToLocal(Model.EventDate).ToString("dd.MM")})?";
}
<div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
    <h1 class="h4 mb-0">@Model.Title</h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.CanEditEvent)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Изменить</a>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Статус:</strong> @Model.StatusDisplayLabel</p>
        <p class="mb-1"><strong>Место:</strong> @Model.Place</p>
        <p class="mb-1"><strong>Дата:</strong> @AppTimeZone.ToLocal(Model.EventDate).ToString("dd.MM.yyyy HH:mm")</p>
        <p class="mb-0"><strong>Регистрация до:</strong> @AppTimeZone.ToLocal(Model.RegistrationClosesAt).ToString("dd.MM.yyyy HH:mm")</p>
    </div>
</div>

@if (Model.CanStartEvent || Model.CanCompleteEvent || Model.CanCancelEvent)
{
    <div class="d-flex flex-column gap-2 mb-3">
        @if (Model.CanStartEvent)
        {
            <form method="post" asp-action="Start"
                  onsubmit="return confirm('Начать мероприятие?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="btn btn-success w-100 py-3">Начать событие</button>
            </form>
        }
        @if (Model.CanCompleteEvent)
        {
            <form method="post" asp-action="Complete"
                  onsubmit="return confirm('Завершить мероприятие?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary w-100 py-3">Завершить мероприятие</button>
            </form>
        }
        @if (Model.CanCancelEvent)
        {
            <form method="post" asp-action="Cancel" class="js-confirm-form" data-confirm-message="@cancelConfirmMessage">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger w-100 py-3">Отменить мероприятие</button>
            </form>
        }
    </div>
}

@if (Model.Judges.Count > 0)
{
    <h2 class="h6">Судьи</h2>
    <ul class="list-group mb-3">
        @foreach (var judge in Model.Judges)
        {
            <li class="list-group-item">@judge.Name</li>
        }
    </ul>
}

@if (Model.CurrentUserIsJudge)
{
    <div class="alert alert-info">Вы назначены судьёй этого события.</div>
}
else if (Model.CurrentUserParticipation is not null)
{
    var p = Model.CurrentUserParticipation;
    <div class="alert alert-secondary">
        Ваша заявка: <strong>@StatusLabel(p.Status)</strong>.
        Техника: @(p.UsesOwnEquipment ? "своя" : "аренда").
    </div>
}
else if (Model.CanApply)
{
    <h2 class="h6">Подать заявку</h2>
    <form method="post" asp-action="Apply" class="card card-body mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="EventId" value="@Model.Id" />
        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="UsesOwnEquipment" id="ownYes" value="true" checked />
            <label class="form-check-label" for="ownYes">Своя техника</label>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="UsesOwnEquipment" id="ownNo" value="false" />
            <label class="form-check-label" for="ownNo">Арендная техника организатора</label>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-3">Подать заявку</button>
    </form>
}
else if (!Model.RegistrationOpen)
{
    <div class="alert alert-warning">Регистрация на событие закрыта или событие уже прошло.</div>
}

@if (Model.CanModerateParticipants)
{
    <div class="d-flex justify-content-between align-items-center gap-2 mt-3 mb-2">
        <h2 class="h6 mb-0">Заявки участников</h2>
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                Выгрузить участников
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       asp-action="ExportParticipants"
                       asp-route-id="@Model.Id"
                       asp-route-format="view"
                       target="_blank"
                       rel="noopener">Открыть для печати</a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-action="ExportParticipants"
                       asp-route-id="@Model.Id"
                       asp-route-format="file">Скачать файл</a>
                </li>
            </ul>
        </div>
    </div>
    @if (Model.Participants.Count == 0)
    {
        <div class="alert alert-secondary">Заявок пока нет.</div>
    }
    else
    {
        @foreach (var group in participantGroups)
        {
            if (group.Items.Count == 0)
            {
                continue;
            }
            <h3 class="h6 text-muted mt-3 mb-2">@group.Title</h3>
            <div class="list-group mb-3">
                @foreach (var p in group.Items)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <div class="fw-semibold">@p.Name</div>
                                <div class="small text-muted">
                                    Статус: @StatusLabel(p.Status) · Техника: @(p.UsesOwnEquipment ? "своя" : "аренда")
                                </div>
                            </div>
                            @if (p.CanConfirm || p.CanReject)
                            {
                                <div class="d-flex gap-1 flex-shrink-0">
                                    @if (p.CanConfirm)
                                    {
                                        <form method="post" asp-action="Confirm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@Model.Id" />
                                            <input type="hidden" name="accountId" value="@p.AccountId" />
                                            <button type="submit" class="btn btn-success btn-sm btn-compact">Подтвердить</button>
                                        </form>
                                    }
                                    @if (p.CanReject)
                                    {
                                        <form method="post" asp-action="Reject" class="js-confirm-form"
                                              data-confirm-message="Вы уверены что хотите отклонить заявку пользователя @p.Name ?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@Model.Id" />
                                            <input type="hidden" name="accountId" value="@p.AccountId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-compact">Отклонить</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

<a class="btn btn-outline-secondary w-100 py-3" asp-action="Index">К списку событий</a>

<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmActionModalLabel">Подтверждение</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="confirmActionModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmActionModalSubmit">Да</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var pendingForm = null;
        var modalEl = document.getElementById('confirmActionModal');
        if (!modalEl) return;

        var modalBody = document.getElementById('confirmActionModalBody');
        var submitBtn = document.getElementById('confirmActionModalSubmit');
        var modal = new bootstrap.Modal(modalEl);

        document.querySelectorAll('form.js-confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                pendingForm = form;
                modalBody.textContent = form.getAttribute('data-confirm-message') || 'Подтвердите действие.';
                modal.show();
            });
        });

        submitBtn.addEventListener('click', function () {
            if (!pendingForm) return;
            var form = pendingForm;
            pendingForm = null;
            modal.hide();
            HTMLFormElement.prototype.submit.call(form);
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            pendingForm = null;
        });
    })();
</script>
}
