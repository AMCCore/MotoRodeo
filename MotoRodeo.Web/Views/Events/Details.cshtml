@model EventDetailsDto
@{
    ViewData["Title"] = Model.Title;
    var canManage = ViewBag.CanManage as bool? ?? false;
    var canParticipate = ViewBag.CanParticipate as bool? ?? false;
}
<h1 class="h4 mb-2">@Model.Title</h1>
<p class="mb-1">@Model.Place</p>
<p class="mb-1">@Model.EventDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
<p class="small text-muted">Статус: @Model.Status. Регистрация до @Model.RegistrationDeadline.ToLocalTime().ToString("dd.MM.yyyy HH:mm"). Групп: @Model.GroupCount.</p>

@if (canParticipate && Model.RegistrationOpen && !Model.IsJudge)
{
    if (Model.IsParticipant)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger w-100 py-3">Отменить участие</button>
        </form>
    }
    else
    {
        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="mb-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success w-100 py-3">Подтвердить участие</button>
        </form>
    }
}

@if (canManage)
{
    <a class="btn btn-outline-primary w-100 py-3 mb-2" asp-action="Edit" asp-route-id="@Model.Id">Редактировать</a>
    <a class="btn btn-outline-secondary w-100 py-3 mb-2" asp-action="Export" asp-route-id="@Model.Id" asp-route-grouped="false">CSV: все участники</a>
    <a class="btn btn-outline-secondary w-100 py-3 mb-2" asp-action="Export" asp-route-id="@Model.Id" asp-route-grouped="true">CSV: по группам</a>
    if (Model.Status != EventStatusEnum.Ready)
    {
        <form asp-action="BuildGrid" asp-route-id="@Model.Id" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning w-100 py-3">Закрыть регистрацию и собрать сетку</button>
        </form>
    }
}

<h2 class="h6 mt-3">Участники (@Model.Participants.Count)</h2>
<ul class="list-group mb-3">
    @foreach (var p in Model.Participants)
    {
        <li class="list-group-item">@p.Name</li>
    }
    @if (Model.Participants.Count == 0)
    {
        <li class="list-group-item text-muted">Никого нет</li>
    }
</ul>

<h2 class="h6">Судьи (@Model.Judges.Count)</h2>
<ul class="list-group mb-3">
    @foreach (var j in Model.Judges)
    {
        <li class="list-group-item">@j.Name</li>
    }
    @if (Model.Judges.Count == 0)
    {
        <li class="list-group-item text-muted">Не назначены</li>
    }
</ul>

@foreach (var group in Model.Groups)
{
    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Группа @group.Number</h2>
            <ul class="list-unstyled">
                @foreach (var m in group.Members)
                {
                    <li>#@m.StartNumber @m.Name</li>
                }
            </ul>
            <h3 class="h6">Заезды</h3>
            @if (group.Heats.Count == 0)
            {
                <p class="text-muted mb-0">Нет заездов</p>
            }
            else
            {
                <ol class="mb-0 ps-3">
                    @foreach (var heat in group.Heats)
                    {
                        <li class="mb-2">Лидер: @heat.LeaderName · догоняющий: @heat.ChaserName</li>
                    }
                </ol>
            }
        </div>
    </section>
}