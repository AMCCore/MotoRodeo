@model IReadOnlyList<EventListItemDto>
@{
    ViewData["Title"] = "События";
    var canManage = ViewBag.CanManage as bool? ?? false;
    var canParticipate = ViewBag.CanParticipate as bool? ?? false;
}
<h1 class="h4 mb-3">События</h1>
@if (canManage)
{
    <a class="btn btn-primary w-100 py-3 mb-3" asp-action="Create">Новое событие</a>
}
@if (Model.Count == 0)
{
    <p class="text-muted">Пока нет событий.</p>
}
@foreach (var ev in Model)
{
    <article class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@ev.Title</h2>
            <p class="mb-1">@ev.Place</p>
            <p class="mb-1">@ev.EventDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
            <p class="small text-muted mb-2">
                @(ev.RegistrationOpen ? "Регистрация открыта до " + ev.RegistrationDeadline.ToLocalTime().ToString("dd.MM.yyyy") : ev.Status)
                · участников: @ev.ParticipantCount
            </p>
            <a class="btn btn-outline-primary w-100 py-3" asp-action="Details" asp-route-id="@ev.Id">Открыть</a>
        </div>
    </article>
}